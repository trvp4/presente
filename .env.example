# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API Keys)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Chave secreta: fica só no servidor. Nunca coloque em código do navegador.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Segredo compartilhado com o script do Google Forms do Espaços de Leitura (gere com: npm run assistente -- formulario)
FORMS_SECRET=
